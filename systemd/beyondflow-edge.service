[Unit]
Description=BeyondFlow oeffentlicher Ereignis-Eingang (nginx, HTTPS 443 -> 8443, ACME 80 -> 8089)
After=network-online.target

[Service]
ExecStartPre=-/usr/bin/podman rm -f bf-edge
# --user 0: im rootless Podman ist root = der VM-Benutzer, so liest nginx den Schluessel (Rechte 600)
ExecStart=/usr/bin/podman run --rm --name bf-edge --network host --user 0:0 \
  -v %h/beyondflow/edge/edge.conf:/etc/nginx/conf.d/default.conf:ro,Z \
  -v %h/beyondflow/edge/certs:/etc/bf-certs:ro,Z \
  -v %h/beyondflow/edge/acme:/srv/acme:ro,Z \
  docker.io/nginxinc/nginx-unprivileged:alpine
ExecStop=/usr/bin/podman stop -t 5 bf-edge
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
