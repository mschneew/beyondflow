[Unit]
Description=BeyondFlow Geheimnisse aus OCI Vault laden (nur im Arbeitsspeicher: %t/beyondflow/secrets.env)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# BF_VAULT_OCID (keine Geheimnisse) schreibt install.sh hierher
EnvironmentFile=%h/beyondflow/config/vault.env
ExecStart=/usr/bin/python3 %h/beyondflow/vault/bf-vault.py fetch --vault ${BF_VAULT_OCID} --prefix BF_ --out %t/beyondflow/secrets.env
ExecStopPost=/bin/rm -f %t/beyondflow/secrets.env
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
