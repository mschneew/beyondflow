[Unit]
Description=BeyondFlow Studio (Kaoto + Studio-Oberflaeche, nginx)
After=network-online.target

[Service]
ExecStartPre=-/usr/bin/podman rm -f bf-studio
ExecStart=/usr/bin/podman run --rm --name bf-studio --network host \
  -v %h/kaoto-web:/usr/share/nginx/html:ro,Z \
  -v %h/beyondflow/studio:/srv/studio:ro,Z \
  -v %h/beyondflow/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro,Z \
  docker.io/nginxinc/nginx-unprivileged:alpine
ExecStop=/usr/bin/podman stop -t 5 bf-studio
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
