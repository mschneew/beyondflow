[Unit]
Description=SAP-Gateway: Geheimnisse aus OCI Vault laden (nur im Arbeitsspeicher: /run/sap-gateway/secrets.env)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/sap-bridge.vault
ExecStart=/usr/bin/python3 /usr/local/lib/sapgw/bf-vault.py fetch --vault ${VAULT_OCID} --prefix SAPGW_ --strip SAPGW_ --out /run/sap-gateway/secrets.env
ExecStopPost=/bin/rm -f /run/sap-gateway/secrets.env
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
